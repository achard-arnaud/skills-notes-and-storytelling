{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-brief-content.v1.schema.json",
  "title": "Business brief content v1 — evidence ledger before rendering",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mode",
    "primary_dimension",
    "subject",
    "audience",
    "question",
    "cutoff",
    "template",
    "decision_requested",
    "claims",
    "recommendations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "mode": {"const": "business"},
    "primary_dimension": {"const": "business"},
    "subject": {"$ref": "#/$defs/subject"},
    "audience": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "cutoff": {"type": "string", "format": "date"},
    "template": {"$ref": "#/$defs/template"},
    "decision_requested": {"type": "boolean"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/recommendation"}
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "published_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "primary_independent",
            "primary_regulatory",
            "primary_vendor",
            "primary_corporate",
            "secondary_independent",
            "supplied_context"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "grade",
        "source",
        "confidence",
        "contradiction",
        "contradiction_detail",
        "unknowns"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "supplied_claim",
            "attributed_claim",
            "inference",
            "hypothesis",
            "verified_fact",
            "unknown"
          ]
        },
        "grade": {"enum": ["A", "B", "C", "D", "unknown"]},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "contradiction": {"enum": ["none_found", "present", "unknown"]},
        "contradiction_detail": {"type": "string"},
        "unknowns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "role"],
      "properties": {
        "status": {"enum": ["assigned", "unassigned"]},
        "role": {"type": "string", "minLength": 1},
        "assignee": {"type": "string", "minLength": 1}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "option", "conditions", "falsifier", "action", "owner", "gate"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "option": {"type": "string", "minLength": 1},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "falsifier": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "gate": {"type": "string", "minLength": 1}
      }
    }
  }
}
