{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-planning.v1.schema.json",
  "title": "Analysis planning v1 — explicit mandate, evidence requirements, no execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "intent_ref",
    "study_ref",
    "input_revision",
    "intent_revision",
    "catalog_revision",
    "questions",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1
    },
    "study_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_publications",
        "max_queries"
      ],
      "properties": {
        "max_publications": {
          "type": "integer",
          "minimum": 1
        },
        "max_queries": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "intentBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "study_ref",
        "question",
        "scope",
        "audience",
        "intent",
        "decision_requested",
        "as_of"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "study_ref": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "traction-commerciale",
            "clients-360"
          ]
        },
        "decision_requested": {
          "type": "boolean"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "method",
        "method_version",
        "input_claim_refs",
        "evidence_map",
        "unknowns",
        "queries",
        "stop_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "input_claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "claim_refs"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "claim_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
