{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-writing.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_ref",
    "envelope_revision",
    "candidate_thesis",
    "observations",
    "claim_disposition"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "study_ref": {
      "type": "string",
      "minLength": 1
    },
    "envelope_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "finding_refs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/findingRef"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/findingRef"
      }
    },
    "claim_disposition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_ref",
          "state",
          "reason"
        ],
        "properties": {
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "included",
              "displaced",
              "omitted"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "findingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_ref",
        "finding_index"
      ],
      "properties": {
        "analysis_ref": {
          "type": "string",
          "minLength": 1
        },
        "finding_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readerScaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "analysis_refs",
              "claim_ids",
              "pillar_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "analysis_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "claim_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pillar_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
