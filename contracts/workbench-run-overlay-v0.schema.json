{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench-run-overlay-v0.schema.json",
  "title": "Candidate Workbench Coach Overlay v0.1 (proposal only)",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "template_ref",
    "analysis_dimension",
    "generation_mode",
    "research_mode",
    "decision_question",
    "toc",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "company",
            "product",
            "company_product"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "template_ref": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "analysis_dimension": {
      "enum": [
        "business",
        "product",
        "technical"
      ]
    },
    "secondary_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "business",
          "product",
          "technical"
        ]
      },
      "maxItems": 2
    },
    "generation_mode": {
      "enum": [
        "from-scratch",
        "iterative"
      ]
    },
    "research_mode": {
      "enum": [
        "reuse",
        "refresh",
        "search",
        "deepsearch"
      ]
    },
    "cutoff": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "decision_question": {
      "type": "string",
      "minLength": 8
    },
    "thesis": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "toc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "rank",
          "stars"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "rationale": {
            "type": "string"
          },
          "target_words": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "must_include_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "must_not_claim": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_perspective": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "docx",
          "pdf",
          "html",
          "md"
        ]
      }
    },
    "approved_budget": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_sources": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "This JSON schema validates overlay shape only. A separate registry-aware validator MUST check template section IDs, required sections, dependency order, approved template sha, claim scope and workflow permissions."
}
