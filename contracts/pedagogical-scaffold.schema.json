{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pedagogical-scaffold.schema.json",
  "title": "PedagogicalHtmlScaffold",
  "description": "Structure sémantique des six pages HTML. Le CSS, les tokens visuels et le moteur de rendu sont hors de ce contrat.",
  "type": "object",
  "required": [
    "template_class",
    "template_type",
    "scaffold_version",
    "document_title",
    "pages"
  ],
  "properties": {
    "template_class": {
      "const": "pedagogique"
    },
    "template_type": {
      "const": "ai-enterprise-learning-six-page"
    },
    "scaffold_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "document_title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "fr",
        "en"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "semantic_role",
          "sections"
        ],
        "properties": {
          "page_id": {
            "enum": [
              "p1",
              "p2",
              "p3",
              "p4",
              "p5",
              "p6"
            ]
          },
          "semantic_role": {
            "enum": [
              "orientation",
              "teach_back",
              "systems_map",
              "maturity_path",
              "value_chain",
              "use_case_backlog"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "section_id",
                "heading",
                "content_ref"
              ],
              "properties": {
                "section_id": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "content_ref": {
                  "type": "string"
                },
                "visual_role": {
                  "enum": [
                    "text",
                    "callout",
                    "table",
                    "diagram",
                    "matrix",
                    "prompt"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
