{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pedagogical-binding.schema.json",
  "title": "PedagogicalContentBinding",
  "description": "Variables et contenu éditorial. Ne décrit ni la structure HTML ni le style CSS.",
  "type": "object",
  "required": [
    "template_class",
    "template_type",
    "program_id",
    "module_id",
    "capacity_id",
    "audience",
    "source_ledger",
    "pages"
  ],
  "properties": {
    "template_class": {
      "const": "pedagogique"
    },
    "template_type": {
      "const": "ai-enterprise-learning-six-page"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "capacity_id": {
      "enum": [
        "prediction",
        "perception",
        "creation",
        "reasoning",
        "agentic",
        "multicapability"
      ]
    },
    "capacity_label": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "object",
      "required": [
        "learner_level",
        "role",
        "use_context"
      ],
      "properties": {
        "learner_level": {
          "enum": [
            "beginner",
            "mixed",
            "advanced"
          ]
        },
        "role": {
          "type": "string"
        },
        "use_context": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "locator",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "status": {
            "enum": [
              "read",
              "partial",
              "secondary",
              "user_supplied"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "prior_module_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "backlog_catalog_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "backlog_size": {
      "type": "integer",
      "minimum": 0
    },
    "selected_use_case_count": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "pages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "headline",
          "takeaway",
          "blocks"
        ],
        "properties": {
          "page_id": {
            "enum": [
              "p1",
              "p2",
              "p3",
              "p4",
              "p5",
              "p6"
            ]
          },
          "headline": {
            "type": "string"
          },
          "takeaway": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "block_id",
                "content"
              ],
              "properties": {
                "block_id": {
                  "type": "string"
                },
                "content": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
