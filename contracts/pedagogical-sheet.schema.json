{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Six-page pedagogical content — single active contract",
  "type": "object",
  "required": [
    "version",
    "id",
    "template_class",
    "title",
    "subtitle",
    "audience",
    "status",
    "programme_alignment",
    "catalog_ref",
    "sources",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "template_class": {
      "const": "pedagogique"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed"
      ]
    },
    "programme_alignment": {
      "enum": [
        "proposed_pending_syllabus",
        "mapped"
      ]
    },
    "catalog_ref": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "locator",
          "url",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "lead",
          "takeaway",
          "source_ids",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "understand",
              "transmit",
              "diagnose",
              "integrate",
              "value",
              "act"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lead": {
            "type": "string",
            "minLength": 1
          },
          "takeaway": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "object",
            "description": "Semantic slots defined by the six page builders; no HTML, CSS or layout fields."
          }
        }
      }
    }
  }
}
