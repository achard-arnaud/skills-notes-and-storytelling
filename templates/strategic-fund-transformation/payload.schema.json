{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategic-fund-transformation-payload.schema.json",
  "title": "Strategic fund transformation note v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "template_version", "render_profile", "program", "entity", "language", "cutoff", "lineage", "sources", "figures", "pages"],
  "properties": {
    "template": {"const": "strategic-fund-transformation-note"},
    "template_version": {"const": "0.2.0"},
    "render_profile": {"const": "fund-note"},
    "program": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "language": {"enum": ["fr", "en"]},
    "cutoff": {"type": "string", "format": "date"},
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "repo_commit", "evidence_status"],
      "properties": {
        "repo": {"type": "string"}, "repo_commit": {"type": "string"},
        "evidence_status": {"enum": ["fixture", "partial", "verified"]},
        "bundle": {"type": "string"}, "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_delta": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["title", "date", "locator", "type"],
      "properties": {"title": {"type": "string"}, "date": {"type": "string"},
        "locator": {"type": "string"}, "type": {"enum": ["primary", "peer", "vendor", "provided", "internal"]}}}},
    "figures": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["value", "src", "kind"],
      "properties": {"value": {"type": "string"}, "src": {"type": "string"},
        "kind": {"enum": ["fact", "calc"]}, "calc": {"type": "string"}},
      "if": {"properties": {"kind": {"const": "calc"}}}, "then": {"required": ["calc"]}}},
    "pages": {"type": "array", "minItems": 5, "maxItems": 7,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "title", "subtitle", "blocks", "source_ids", "takeaway"],
        "properties": {
          "id": {"enum": ["thesis", "drivers", "deployment", "investment", "economics", "roadmap", "sources_limits"]},
          "title": {"type": "string", "minLength": 4},
          "subtitle": {"type": "string", "maxLength": 130},
          "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
            "required": ["heading", "body", "claim_kind", "source_ids", "takeaway"],
            "properties": {"heading": {"type": "string"}, "body": {"type": "string"},
              "claim_kind": {"enum": ["fact", "calc", "inference", "proposal"]},
              "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "takeaway": {"type": "string", "minLength": 5},
              "style": {"enum": ["default", "dark", "soft", "caution"]},
              "process": {"enum": ["dealflow", "post_deal", "ideation_to_scale"]}}}},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "takeaway": {"type": "string", "minLength": 5}
        }}}
  }
}
